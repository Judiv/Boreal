# ==========================================================
# CONFIGURATION DE LA BASE DE DONNÉES (PRISMA)
# ==========================================================
# Si tu lances en LOCAL (sans Docker) : utilise "localhost"
# Si tu lances avec DOCKER : remplace "localhost" par "db"
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ==========================================================
# AUTHENTIFICATION & URLS
# ==========================================================
# NODE_ENV : 'development' en local, 'production' sur le serveur
NODE_ENV=development
# URL de base de l'application (pour NextAuth et les liens de redirection)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Secret pour chiffrer les cookies de session (Génère une chaîne aléatoire longue)
NEXTAUTH_SECRET="votre_secret_tres_long_et_aleatoire"

# ==========================================================
# CONFIGURATION EMAIL (SMTP OVH / MX PLAN)
# ==========================================================
EMAIL_HOST="ssl0.ovh.net"
EMAIL_PORT=465
EMAIL_USER="votre-email@domaine.org"
EMAIL_PASS="votre_mot_de_passe"

# ==========================================================
# PUSHER (NOTIFICATIONS TEMPS RÉEL)
# ==========================================================
# Variables côté serveur
PUSHER_APP_ID="votre_app_id"
PUSHER_SECRET="votre_secret"
# Variables côté client (préfixées par NEXT_PUBLIC)
NEXT_PUBLIC_PUSHER_KEY="votre_cle_publique"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ==========================================================
# CLOUDINARY (STOCKAGE D'IMAGES)
# ==========================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="votre_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="votre_preset_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"